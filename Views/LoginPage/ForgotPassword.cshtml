<!DOCTYPE html>
<html>
<head>

    <title>Forgot Password</title>

    <style>

            body {
                font-family: Arial;
                background: #fff3cd;
            }

            .box {
                width: 350px;
                margin: 100px auto;
                background: white;
                padding: 30px;
                box-shadow: 0 0 10px gray;  
                border-radius: 10px;
            }

            input {
                width: 100%;
                padding: 10px;
                margin: 10px 0;
            }

            button {
                width: 100%;
                padding: 10px;
                background: orange;
                color: white;
                border: none;
            }

    </style>

</head>

<body>

    <div class="box">

        <h2 align="center">Forgot Password</h2>

        <form method="post">

            <input type="email" name="email" placeholder="Enter Email" required>

            <button>Reset Password</button>

        </form>

        @if (ViewBag.Message != null)
        {
            <p>@ViewBag.Message</p>
        }

        <p align="center">
            <a asp-action="Index">Back to Login</a>
        </p>

    </div>

</body>
</html>